@startuml state-application
' Диаграмма состояний заявки в шлюзе.
' Переходы сверяются тестом с таблицей src/leasing/states.py: стрелка, которой нет в коде,
' или переход в коде, которого нет здесь, роняет сборку.
' req: FR-04 FR-05 FR-06 FR-08 FR-09
!pragma layout smetana
skinparam shadowing false

[*] --> NEW : заявка заведена
NEW --> SENT : банк принял
NEW --> INVALID : Fault VALIDATION
NEW --> WAITING_RETRY : таймаут, 5xx
WAITING_RETRY --> SENT : повтор принят
WAITING_RETRY --> INVALID : Fault VALIDATION
WAITING_RETRY --> WAITING_RETRY : повтор не удался
WAITING_RETRY --> FAILED : попытки кончились
SENT --> APPROVED : банк одобрил
SENT --> DECLINED : банк отказал
APPROVED --> [*]
DECLINED --> [*]
INVALID --> [*]
FAILED --> [*]
@enduml
